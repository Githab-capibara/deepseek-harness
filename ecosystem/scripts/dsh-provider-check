#!/usr/bin/env python3
"""Ask one model through the harness's own provider chain and report the answer."""
import json
import os
import re
import sys
import urllib.error
import urllib.request

ENV_FILE = os.path.join(os.environ.get('DSH_HOME', '/home/d/.dsh'), '.env')
MODEL = 'hnc/step-5-preview'


def env_value(name: str) -> str:
    with open(ENV_FILE, encoding='utf-8') as fh:
        for line in fh:
            if line.startswith(f'{name}='):
                return line.split('=', 1)[1].strip().strip('"').strip("'")
    raise SystemExit(f'{name} is not set in {ENV_FILE}')


def ask(base_url: str, api_key: str, model: str, prompt: str) -> str:
    body = json.dumps({
        'model': model,
        'messages': [{'role': 'user', 'content': prompt}],
        'max_tokens': 256,
    }).encode('utf-8')
    request = urllib.request.Request(
        f'{base_url}/chat/completions',
        data=body,
        headers={'Content-Type': 'application/json', 'Authorization': f'Bearer {api_key}'},
    )
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            payload = json.loads(response.read().decode('utf-8'))
    except urllib.error.HTTPError as error:
        return f'HTTP {error.code}: {error.read().decode("utf-8")[:200]}'
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        return f'network: {type(error).__name__}: {error}'
    choices = payload.get('choices') or []
    if not choices:
        return f'no choices: {json.dumps(payload)[:200]}'
    message = choices[0].get('message', {})
    # A reasoning model may spend its budget on reasoning and leave the answer
    # empty; the reasoning text still proves the provider answered.
    text = message.get('content') or message.get('reasoning_content') or ''
    if not str(text).strip():
        return f'no answer: {json.dumps(payload)[:200]}'
    return str(text).strip()


def main() -> int:
    prompt = ' '.join(sys.argv[1:]) or 'Ответь одним словом: работает?'
    # The harness routes every model through the `hnc/` prefix: the profile
    # names one provider per model family, and the prefix selects the channel
    # inside the gateway.
    #
    # The allowed model set is fixed and `auto` is never dispatched: a model
    # that is rate-limited on one channel may answer on another, so every
    # channel is asked about every model and the report names the pairs that
    # answered.
    #
    # Each channel names the models its own way: the gateways prefix the
    # family (`hnc/step-5-preview`), while freellmapi's catalog carries the
    # bare lowercase id (`step-5-preview`). A wrong id is a 404, not a
    # refusal, so the id is the channel's own.
    models = [
        'MiniMax-M3.1-Flash',
        'Qwen3.8-Flash-Next',
        'step-5-preview',
        'longcat-2.5',
    ]
    providers = [
        ('omniroute', 'http://localhost:20128/v1', 'OMNIROUTE_API_KEY', 'hnc/'),
        ('hnc', 'https://api.hcnsec.cn/v1', 'HNC_API_KEY', ''),
        ('freellmapi', 'http://localhost:8080/v1', 'FREELLMAPI_API_KEY', '', True),
    ]
    failures = 0
    answered = 0
    for name, base_url, key_name, prefix, *lower in providers:
        try:
            key = env_value(key_name)
        except SystemExit as error:
            print(f'{name}: skipped ({error})')
            continue
        for model in models:
            model_id = model.lower() if lower else model
            answer = ask(base_url, key, prefix + model_id, prompt)
            if answer.startswith(('HTTP', 'network:', 'no choices', 'no answer')):
                print(f'{name}/{prefix}{model_id}: FAILED — {answer[:160]}')
                failures += 1
            else:
                print(f'{name}/{prefix}{model_id}: OK — {answer[:120]}')
                answered += 1
    print(f'\n{answered} of {len(providers) * len(models)} channel/model pairs answered')
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())
