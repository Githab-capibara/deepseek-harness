def build_client_js(tables: dict[str, dict[str, str]]) -> str:
    """The client bundle: it registers the Russian dictionaries."""
    import json as _json
    body = _json.dumps(tables, ensure_ascii=False, indent=2)
    return f"""window.__ModuleLoader__.load({{id:'dsh-local-ru',factory:(require) => {{var module = {{ exports:{{}} }}

// Русские словари для панелей плагинов, которых нет в dsh-russian-lang.
// Названия технологий и API остаются на английском, остальное — на русском.
var TRANSLATIONS = {body};

var CONFIG = {{ enabled: true }}

function apply(ctx, config) {{
  var cfg = Object.assign({{}}, CONFIG, config || {{}})
  if (cfg.enabled === false) return
  var locale = ctx.get('locale')
  if (locale === undefined || typeof locale.register !== 'function') return
  var namespaces = Object.keys(TRANSLATIONS)
  for (var i = 0; i < namespaces.length; i++) {{
    var ns = namespaces[i]
    try {{
      locale.register(ns, {{ ru: TRANSLATIONS[ns] }})
    }} catch (err) {{
      var msg = String(err)
      if (msg.indexOf('already has locale') === -1) {{
        console.log('[dsh-local-ru] ' + ns + ': ' + msg)
      }}
    }}
  }}
}}

module.exports = {{ apply: apply, inject: ['locale'], TRANSLATIONS: TRANSLATIONS }}
return module.exports}},}})
"""


def load_keys() -> dict[str, list[str]]:
    """The key sets extracted from the panels' English tables."""
    with open(KEYS_FILE, encoding="utf-8") as fh:
        return json.load(fh)


def main() -> int:
    keys = load_keys()
    # Report the keys that have no Russian entry: they fall back to English.
    missing_total = 0
    for namespace, entries in keys.items():
        table = TABLES.get(namespace, {})
        missing = [key for key in entries if key not in table]
        missing_total += len(missing)
        status = "OK" if not missing else f"{len(missing)} без перевода"
        print(f"{namespace}: {len(table)} переводов / {len(entries)} ключей — {status}")
        if missing:
            print(f"    без перевода: {', '.join(missing[:12])}")
    print(f"всего ключей без перевода: {missing_total}")
    out = os.path.join(PLUGIN_DIR, "lib", "client.js")
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(build_client_js(TABLES))
    print(f"written: {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
