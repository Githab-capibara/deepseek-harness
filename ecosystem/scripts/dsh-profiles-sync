#!/usr/bin/env python3
"""Rebuild every DSH profile from one template so all front-ends share the
same plugin stack.

Profiles (all boot the same plugins, only the app surface differs):

  web        browser dashboard + always-on systemd service
  ultracode  TUI (dsh-tui 0.20.1) with the UltraCode preset
  dsh-tui    plain TUI surface, same stack
  desktop    the desktop client's own profile (Electron carrier boots it)
  decay      web surface where dsh-context-decay owns context reduction
  headless   one-shot `dsh headless "task"` surface

Context reduction: exactly ONE reducer may run at a time. dsh-context-decay
(model-driven, the NVIDIA "you don't need long context" method) is mounted
everywhere, so the official automatic compaction (host `compaction-basic.auto`,
the preset's compaction group and @ohmejj/dsh-auto-compact) is switched off.
The manual `/compact` command stays available as an emergency fallback.

The script is idempotent and re-runnable; it only rewrites the profile
manifest, patch layer and pnpm settings, then reinstalls the dependencies.
"""
import json
import os
import re
import shutil
import subprocess
import sys

# The ecosystem lives next to this script inside the fork, so every path is
# derived from the script location: the fork works from any checkout.
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
ECOSYSTEM_DIR = os.path.dirname(SCRIPT_DIR)
REPO_ROOT = os.path.dirname(ECOSYSTEM_DIR)
PLUGINS_DIR = os.path.join(ECOSYSTEM_DIR, "plugins")

HOME = os.environ.get("DSH_HOME", "/home/d/.dsh")
PROFILES = os.path.join(HOME, "profiles")
# The canonical profile template lives in the fork, not in the profile it
# generates: a template read back from its own output would be rewritten by
# the next run and lose the configuration.
TEMPLATE = os.path.join(ECOSYSTEM_DIR, "profiles", "ultracode")


def local_plugin(name: str) -> str:
    """A `file:` dependency on a plugin shipped by this fork."""
    return "file:" + os.path.join(PLUGINS_DIR, name)


def local_runtime() -> dict[str, str]:
    """The fork's runtime packages, linked into the profile.

    A plugin peer-depends on `@deepseek-ai/dsh-*`. Without a link the profile
    installs the npm release of that package, which shadows the fork's runtime
    with an older one and crashes the host on startup. `link:` in
    `pnpm.overrides` only applies to DIRECT dependencies, so the runtime
    packages are listed as direct ones.
    """
    linked = {}
    for name, relative in RUNTIME_PACKAGES.items():
        linked[name] = "link:" + os.path.join(REPO_ROOT, relative)
    return linked


PLUGIN_DEPS = {
    # Pinned to the upstream commit that carries the config-driven settings
    # port: a plain `github:` specifier resolves to whatever the registry
    # cached, which may predate this runtime.
    "@doiiarx/dsh-todo-continuation": "github:DoiiarX/dsh-todo-continuation#52e2eb44e5a53605331d8938c76dd3783b327ef6",
    "dsh-git-worktree": "github:KHG420/git-worktree",
    "dsh-gitnexus-plugin": "github:akash-digitavision/dsh-gitnexus-plugin",
    "dsh-context-decay": "github:LDyty/dsh-context-decay",
    "dsh-plugin-stalegreen": "^0.1.0",
    "dsh-protect-tests": "^0.2.3",
    "dsh-subagent-guard": "github:NightPainters/dsh-subagent-guard",
    "dsh-swarm-orchestrator": "0.6.34",
    "dsh-task-reliability": "^0.4.11",
    "dsh-ultracode": "github:ParticleLight/dsh-ultracode",
    "dsh-verify-judge": "github:zriyox/dsh-verify-judge",
    "dsh-verify-kit": "github:xushilianzhuren/dsh-verify-kit",
    "dsh-workflow-worktree": "github:lisycotana/dsh-workflow-worktree",
    "dsh-worktree": "github:CSY656/dsh-worktree",
    "dsh-subagent-compat": local_plugin("dsh-subagent-compat"),
    "dsh-swarm-autonomy-guard": local_plugin("dsh-swarm-autonomy-guard"),
    "dsh-swarm-worktree": local_plugin("dsh-swarm-worktree"),
    # ── Надёжность и безопасность (см. анализ траектории) ──────────────
    # dsh-agent-loop-guard: рвёт dedup-циклы повторных tool-вызовов
    #   (в траектории: 11 одинаковых read models.rs подряд).
    "@goodandready/dsh-agent-loop-guard": "0.2.29",
    # dsh-baseline: fail-closed безопасность — egress, монотонный потолок
    #   прав субагентов, хеш-цепоченный аудит решений.
    "dsh-baseline": "0.1.0",
    # dsh-auto-review: отвечает ЗА пользователя на approval-запросы
    #   (второй read-only ревьюер, fail-closed).
    "dsh-auto-review": "0.15.1",
    # dsh-second-review: независимая оценка промпта/плана/качества работы
    #   вторым агентом — карточка под каждым ответом.
    "dsh-second-review": "1.3.6",
    # dsh-stall-guard: сторож простоя — сам находит зависшие команды и
    #   будит агента, когда он полностью остановился.
    "dsh-stall-guard": "0.1.9",
    # dsh-session-retry: перезапускает упавший turn сам, с растущим backoff.
    "dsh-session-retry": "0.3.0",
    # dsh-agent-frugality: механический completion gate (exit-0) + review
    #   lane на дешёвой модели — «готово» = объективно проверено.
    "dsh-agent-frugality": "0.1.5",
    # Полная русская локализация ядра и экосистемы плагинов.
    "@goodandready/dsh-russian-lang": "0.4.27",
    # Переводы для плагинов, которых НЕТ в dsh-russian-lang (мой стек:
    # swarm-orchestrator, baseline, context-decay, session-retry,
    # stall-guard, second-review, agent-loop-guard, auto-review,
    # agent-frugality, verify-kit, verify-judge, protect-tests,
    # task-reliability, ultracode, subagent-guard, stalegreen).
    "dsh-local-ru": local_plugin("dsh-local-ru"),
}

PLUGIN_BUNDLES = [
    "dsh-swarm-orchestrator",
    "dsh-task-reliability",
    "dsh-protect-tests",
    "dsh-plugin-stalegreen",
    "dsh-subagent-guard",
