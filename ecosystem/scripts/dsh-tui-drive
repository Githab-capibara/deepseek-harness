"""Drive the TUI with a task whose file lives inside the repository.

The swarm worker writes inside its own worktree, so the task names a path
under the repository. The check then reports whether the file exists in the
main tree or in a worktree.
"""
import os
import pty
import select
import subprocess
import sys
import time

TASK = ' '.join(sys.argv[1:]) or (
    'Создай файл ecosystem-check/agent-demo/notes.txt с тремя строками: alpha, beta, gamma. '
    'Затем прочитай этот файл обратно и покажи его содержимое.'
)
DURATION = int(os.environ.get('DSH_TUI_SECONDS', '900'))
OUT = os.environ.get('DSH_TUI_OUT', '/tmp/opencode/tui-screen.txt')


def main() -> int:
    master, slave = pty.openpty()
    import fcntl
    import struct
    import termios
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 50, 200, 0, 0))

    process = subprocess.Popen(
        ['dsh', 'dsh-tui'],
        stdin=slave, stdout=slave, stderr=slave,
        cwd='/home/d/my/deepseek-harness',
        env={**os.environ, 'TERM': 'xterm-256color', 'COLUMNS': '200', 'LINES': '50'},
    )
    os.close(slave)
    captured = []

    def drain(seconds: float) -> None:
        deadline = time.time() + seconds
        while time.time() < deadline:
            ready, _, _ = select.select([master], [], [], 0.4)
            if not ready:
                continue
            try:
                data = os.read(master, 65536)
            except OSError:
                break
            if not data:
                break
            captured.append(data.decode('utf-8', 'replace'))

    drain(12)
    os.write(master, TASK.encode('utf-8'))
    time.sleep(1.5)
    os.write(master, b'\r')
    drain(DURATION)

    with open(OUT, 'w', encoding='utf-8') as fh:
        fh.write(''.join(captured))
    try:
        os.write(master, b'/exit\r')
        drain(8)
    except OSError:
        pass
    process.terminate()
    try:
        process.wait(timeout=20)
    except subprocess.TimeoutExpired:
        process.kill()
    with open(OUT, 'w', encoding='utf-8') as fh:
        fh.write(''.join(captured))
    print(f'captured {len(captured)} chunks into {OUT}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
