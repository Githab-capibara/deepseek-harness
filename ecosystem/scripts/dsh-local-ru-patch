def patch_probe(text: str) -> str | None:
    """Make the language probe return 'ru' for a Russian host."""
    for name in PROBE_NAMES:
        pattern = re.compile(
            r"(function\s+" + name + r"\s*\(\)\s*\{)(.*?)(\n\s*\})",
            re.S,
        )
        match = pattern.search(text)
        if match is None:
            continue
        body = match.group(2)
        if "startsWith('ru')" in body or 'startsWith("ru")' in body:
            return None
        # The probe returns a boolean today. Turn it into a language code and
        # keep the boolean call sites working by returning a truthy string.
        replacement = (
            "\n    // Русская локаль: плагин выбирает русские строки.\n"
            "    try {\n"
            "        const host = (document.documentElement.lang || '').toLowerCase();\n"
            "        if (host.startsWith('ru'))\n"
            "            return 'ru';\n"
            "        if (host.startsWith('zh'))\n"
            "            return 'zh';\n"
            "    }\n"
            "    catch {\n"
            "        /* no document (node render) */\n"
            "    }\n"
            "    try {\n"
            "        const browser = (navigator.language || 'en').toLowerCase();\n"
            "        if (browser.startsWith('ru'))\n"
            "            return 'ru';\n"
            "        if (browser.startsWith('zh'))\n"
            "            return 'zh';\n"
            "    }\n"
            "    catch {\n"
            "        return 'en';\n"
            "    }"
        )
        return pattern.sub(lambda m: m.group(1) + replacement + m.group(3), text, count=1)
    return None


def main() -> int:
    changed = 0
    scanned = 0
    for root in PLUGINS:
        if not os.path.isdir(root):
            continue
        for dirpath, _dirnames, filenames in os.walk(root):
            for filename in filenames:
                if not filename.endswith((".js", ".mjs")):
                    continue
                path = os.path.join(dirpath, filename)
                try:
                    with open(path, encoding="utf-8") as fh:
                        text = fh.read()
                except (OSError, UnicodeDecodeError):
                    continue
                if "isZh" not in text and "isChinese" not in text:
                    continue
                scanned += 1
                patched = patch_probe(text)
                if patched is None:
                    continue
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(patched)
                changed += 1
                print(f"russian-lang: patched probe in {path}")
    print(f"russian-lang: scanned={scanned} changed={changed}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
