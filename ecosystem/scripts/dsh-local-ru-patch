#!/usr/bin/env python3
"""Add a Russian branch to the plugins that pick their language themselves.

Several ecosystem plugins do not use `ctx.locale`: they read the browser
language (`navigator.language`) or the host locale (`<html lang>`) and then
choose between a Chinese and an English string table. When the Russian
locale is active (`<html lang="ru-RU">`), those plugins fall back to English
and the UI stays half-translated.

This script rewrites the language probe so that a Russian host selects the
Russian table, and adds the Russian strings.

Idempotent: a plugin that already carries a Russian branch is left alone.
"""
import os
import re
import sys

PLUGINS = [
    "/home/d/.dsh/profiles/web/node_modules",
]

# The probe used by the plugins: `isZh()` / `isChinese()`.
PROBE_NAMES = ("isZh", "isChinese", "isZhLocale")

# English -> Russian for the recurring UI words of the patched plugins.
WORDS = {
    "Task Reliability": "Надёжность задач",
    "Reliability tracking": "Отслеживание надёжности",
    "Completion verify": "Проверка завершённости",
