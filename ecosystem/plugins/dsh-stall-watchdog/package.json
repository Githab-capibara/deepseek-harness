{
  "name": "dsh-stall-watchdog",
  "version": "1.0.0",
  "description": "Steers a turn that only thinks: when a step streams reasoning for too long without calling a tool or answering, the plugin tells the agent to act, so the session cannot spin on a spinner until it times out.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "stall",
    "watchdog"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "*"
  }
}
