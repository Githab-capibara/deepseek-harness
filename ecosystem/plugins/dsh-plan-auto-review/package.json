{
  "name": "dsh-plan-auto-review",
  "version": "1.0.0",
  "description": "Lets a reviewer agent decide a plan instead of the human: the reviewer checks the plan against the repository and answers approve or reject with its reasons, so plan mode advances on its own.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "plan",
    "review"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}
