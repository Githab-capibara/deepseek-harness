+/**
+* Detect a provider-side quota wall: the account ran out of credit/budget, so
+* the request was refused with a 403 that carries a quota reason. Upstream
+* providers spell this differently ("insufficient_user_quota", "Not enough
+* quota to pre-consume", "insufficient balance", ...), and the harness usually
+* surfaces it under a generic AUTH code, so the message has to be inspected.
+* @param code - the typed failure code.
+* @param status - the HTTP status, when the provider exposed one.
+* @param message - the raw failure message, when the provider exposed one.
+* @returns true when the failure is a quota wall rather than a bad credential.
+*/
+export function isQuotaFailure(code, status, message) {
+    if (/QUOTA|CREDITS_EXHAUSTED|INSUFFICIENT_BALANCE/.test(code))
+        return true;
+    if (typeof message !== 'string' || message.length === 0)
+        return false;
+    return /insufficient_user_quota|not enough quota|quota (?:exceeded|insufficient|exhausted)|insufficient balance|insufficient funds|\u4f59\u989d\u4e0d\u8db3|\u989d\u5ea6\u4e0d\u8db3|balance is not enough/i.test(message);
+}
